generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  ADMIN
  CLIENT
}

model User {
  id                       Int                   @id @default(autoincrement())
  email                    String                @unique
  password                 String
  name                     String?
  firstName                String?
  lastName                 String?
  phone                    String?
  avatarUrl                String?
  role                     UserRole              @default(CLIENT)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  proofCamScans            ProofCamScan[]
  createdInventoryProducts InventoryProduct[]    @relation("CreatedInventoryProducts")
  inventoryUsages          InventoryUsage[]      @relation("InventoryUsagesByUser")
  stockInvoiceBackups      StockInvoiceBackup[]
  attendanceSchedules      AttendanceSchedule[]
  attendanceEvents         AttendanceEvent[]
  attendanceDayOffs        AttendanceDayOff[]
  attendanceQrSessions     AttendanceQrSession[]
  attendanceOverrides      AttendanceOverride[]
  attendanceApprovals      AttendanceOverride[] @relation("AttendanceOverrideApprovers")
}

model Order {
  id     Int     @id @default(autoincrement())
  client String
  amount Float
  status String
  image  String?
}

model Claim {
  id        Int      @id @default(autoincrement())
  orderId   Int
  reason    String
  status    String
  createdAt DateTime @default(now())
}

model Proof {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  hash      String
  createdAt DateTime @default(now())
}

model ProofCamScan {
  id           Int       @id @default(autoincrement())
  imageUrl     String
  processedUrl String?
  ticketNumber String?
  customerName String?
  phoneNumber  String?
  ticketDate   DateTime?
  totalAmount  Float?
  parsedData   Json?
  validation   Json?
  userId       Int?
  user         User?     @relation(fields: [userId], references: [id])
  originalName String?
  rawText      String?   @db.Text
  status       String    @default("processing")
  createdAt    DateTime  @default(now())

  @@index([ticketNumber])
  @@index([createdAt])
  @@index([status])
  @@index([userId])
}

enum StockUnit {
  CARTON
  KG
}

model InventoryProduct {
  id             Int                  @id @default(autoincrement())
  name           String
  price          Float
  stockQuantity  Float                @default(0)
  stockUnit      StockUnit
  alertThreshold Float
  createdById    Int?
  createdBy      User?                @relation("CreatedInventoryProducts", fields: [createdById], references: [id])
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  usages         InventoryUsage[]
  alerts         StockAlert[]
  invoiceBackups StockInvoiceBackup[]

  @@index([name])
}

model InventoryUsage {
  id        Int       @id @default(autoincrement())
  productId Int
  storeId   Int
  quantity  Float
  unit      StockUnit
  createdAt DateTime  @default(now())

  product InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  store   User             @relation("InventoryUsagesByUser", fields: [storeId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([storeId])
  @@index([createdAt])
}

model StockAlert {
  id        Int      @id @default(autoincrement())
  productId Int
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  product InventoryProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isRead])
  @@index([createdAt])
}

model StockInvoiceBackup {
  id                 Int               @id @default(autoincrement())
  imageUrl           String
  originalName       String?
  amount             Decimal?          @db.Decimal(10, 2)
  uploadedById       Int?
  uploadedBy         User?             @relation(fields: [uploadedById], references: [id])
  createdAt          DateTime          @default(now())
  InventoryProduct   InventoryProduct? @relation(fields: [inventoryProductId], references: [id])
  inventoryProductId Int?

  @@index([uploadedById])
  @@index([createdAt])
}

model Notification {
  id        Int       @id @default(autoincrement())
  title     String
  message   String
  role      UserRole?
  isRead    Boolean   @default(false)
  metadata  Json?
  createdAt DateTime  @default(now())

  @@index([role])
  @@index([isRead])
  @@index([createdAt])
}

model DatasetRelease {
  id             Int      @id @default(autoincrement())
  kind           String   @default("proofcam")
  csvPath        String?
  jsonPath       String?
  availableFrom  DateTime
  availableUntil DateTime
  isActive       Boolean  @default(true)
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([kind, isActive])
  @@index([availableUntil])
}

enum AttendanceEventType {
  CHECK_IN
  BREAK_START
  BREAK_END
  CHECK_OUT
}

enum AttendanceQROverrideType {
  FORCE_OPEN
  FORCE_ACCEPT
  FORCE_CLOSE
}

model AttendanceTeam {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedules   AttendanceSchedule[]
  assignments AttendanceTeamDayAssignment[]
}

model AttendanceTeamDayAssignment {
  id        Int      @id @default(autoincrement())
  teamId    Int
  dayOfWeek Int
  createdAt DateTime @default(now())

  team AttendanceTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, dayOfWeek])
  @@index([dayOfWeek])
}

enum AttendanceApprovalStatus {
  ACCEPTED
  SUSPICIOUS
  OVERRIDDEN
  REJECTED
}

model AttendanceAllowedIp {
  id        Int      @id @default(autoincrement())
  restaurant String
  ip        String
  label     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurant, ip])
  @@index([restaurant])
}

model AttendanceKioskIp {
  id        Int      @id @default(autoincrement())
  restaurant String
  ip        String
  label     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurant, ip])
  @@index([restaurant])
}

model AttendanceOverride {
  id              Int                     @id @default(autoincrement())
  eventId         Int?                    @unique
  userId          Int?
  scheduleId      Int?
  reason          String?
  approvedBy      Int?
  status          AttendanceApprovalStatus @default(OVERRIDDEN)
  metadata        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  event     AttendanceEvent?            @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user      User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  schedule  AttendanceSchedule?         @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  approver  User?                       @relation("AttendanceOverrideApprovers", fields: [approvedBy], references: [id])
}

model AttendanceSchedule {
  id                    Int                   @id @default(autoincrement())
  userId                Int
  teamId                Int?
  restaurant            String?
  dayOfWeek             Int
  startTime             String
  endTime               String
  breakMinAfterHours    Int                   @default(2)
  breakMinutes          Int                   @default(60)
  maxBreakPerDay        Int                   @default(2)
  manualOverrideAllowed Boolean               @default(false)
  qrWindowMinutes       Int                   @default(30)
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  qrSessions            AttendanceQrSession[]
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team                  AttendanceTeam?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  attendanceEvents      AttendanceEvent[]
  overrides             AttendanceOverride[]

  @@index([userId])
  @@index([teamId])
  @@index([dayOfWeek])
}

model AttendanceDayOff {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
}

model AttendanceQrSession {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  scheduleId Int?
  openedById Int?
  openedAt   DateTime @default(now())
  expiresAt  DateTime
  isOpen     Boolean  @default(true)
  manualOpen Boolean  @default(false)
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  schedule AttendanceSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  openedBy User?               @relation(fields: [openedById], references: [id], onDelete: SetNull)
  events   AttendanceEvent[]

  @@index([isOpen])
  @@index([expiresAt])
}

model AttendanceEvent {
  id         Int                 @id @default(autoincrement())
  userId     Int
  scheduleId Int?
  sessionId  Int?
  eventType  AttendanceEventType
  eventAt    DateTime            @default(now())
  ipAddress  String?
  userAgent  String?
  qrToken    String?
  isManual   Boolean             @default(false)
  isOverride Boolean             @default(false)
  isSuspicious Boolean            @default(false)
  approvalStatus AttendanceApprovalStatus @default(ACCEPTED)
  rejectionReason String?
  note       String?
  createdAt  DateTime            @default(now())

  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedule AttendanceSchedule?  @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  session  AttendanceQrSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  override AttendanceOverride?

  @@index([userId])
  @@index([eventType])
  @@index([eventAt])
  @@index([sessionId])
  @@index([approvalStatus])
  @@index([isSuspicious])
}

model RestaurantKiosk {
  id        Int      @id @default(autoincrement())
  name      String
  qrSecret  String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RestaurantHours {
  id          Int      @id @default(autoincrement())
  name        String
  openDays    Int[]
  openTime    String
  closeTime   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}